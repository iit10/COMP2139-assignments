@model SmartInventory3.Models.ErrorViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>404 - Page Not Found</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        body { font-family: Arial, sans-serif; margin: 40px; background-color: #f2f2f2; }
        .error-container { background: white; padding: 20px; border-radius: 5px; max-width: 600px; margin: auto; text-align: center; }
        h1 { color: #f0ad4e; }
        a { text-decoration: none; color: #337ab7; }
    </style>
</head>
<body>
<div class="error-container">
    <h1>404 - Page Not Found</h1>
    <p>The resource you are looking for could not be found.</p>
    @if (!string.IsNullOrEmpty(Model.RequestId))
    {
        <p><strong>Request ID:</strong> @Model.RequestId</p>
    }
    <a href="@Url.Action("Index", "Home")">Return to Home Page</a>
</div>
</body>
</html>