@using SmartInventory3.Models
@model Product

<div class="container mt-4">
    <h2>Create Product</h2>

    <!-- AJAX loader (optional if using AJAX later) -->
    <div id="productLoader" class="text-center" style="display: none;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Saving your product...</span>
        </div>
    </div>

    <!-- Response message -->
    <div id="productMessage" class="mt-3"></div>

    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label"></label>
            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select"></select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label"></label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Quantity" class="form-label"></label>
            <input asp-for="Quantity" class="form-control" />
            <span asp-validation-for="Quantity" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="LowStockThreshold" class="form-label"></label>
            <input asp-for="LowStockThreshold" class="form-control" />
            <span asp-validation-for="LowStockThreshold" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success">Create Product</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
}