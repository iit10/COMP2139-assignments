@model IEnumerable<SmartInventory3.Models.Product>

<table class="table table-striped">
    <thead>
    <tr>
        <th>Name</th>
        <th>Category</th>
        <th>Price</th>
        <th>Quantity</th>
        <th>Low Stock Threshold</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Category?.Name</td>
            <td>@item.Price.ToString("C")</td>
            <td>@item.Quantity</td>
            <td>@item.LowStockThreshold</td>
            <td>
                <a href="/Products/Edit/@item.Id" class="btn btn-sm btn-warning">Edit</a>
                <a href="/Products/Delete/@item.Id" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>